<local:MyCard Title="API 设置（支持自建实例）" Margin="0,0,0,15" CanSwap="True" IsSwapped="True">
    <StackPanel Margin="25,40,23,15">
        <TextBlock TextWrapping="Wrap"
                   FontSize="12.5"
                   Foreground="#666666"
                   Margin="0,0,0,6"
                   Text="默认使用官方 API。也可以填你自己部署的一言实例根地址；脚本会自动补上 encode=json 和 charset=utf-8。自建实例返回 hitokoto 字段即可，兼容 text / quote / content 以及 data 包装。" />

        <TextBox x:Name="ApiBox"
                 Text="{variable:HitokotoApiUrl:https://v1.hitokoto.cn/}"
                 Height="34"
                 Margin="0,2,0,8"
                 Padding="9,0"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 Background="#F7F9FC"
                 BorderBrush="{DynamicResource ColorBrush5}"
                 BorderThickness="1"
                 Foreground="#333333"
                 MaxLength="300"
                 ToolTip="例如 https://v1.hitokoto.cn/ 或 https://你的服务器/api/hitokoto" />

        <WrapPanel Margin="0,0,0,4">
            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="18,0,18,0"
                            ColorType="Highlight"
                            Text="保存并测试"
                            ToolTip="保存 API 地址并立即请求一句测试"
                            EventType="执行命令"
                            EventData="{Binding Text, ElementName=ApiBox, StringFormat='wscript.exe|//nologo &quot;HitokotoRun.vbs&quot; -Action set-api -ApiUrl &quot;{0}&quot;'}">
                <local:CustomEventService.Events>
                    <local:CustomEventCollection>
                        <local:CustomEvent Type="弹出提示" Data="正在保存并测试 API 地址……" />
                    </local:CustomEventCollection>
                </local:CustomEventService.Events>
            </local:MyButton>

            <local:MyTextButton Margin="4,0,10,8"
                                Text="恢复官方 API"
                                ToolTip="把 API 地址恢复为 https://v1.hitokoto.cn/"
                                EventType="执行命令"
                                EventData="wscript.exe|//nologo &quot;HitokotoRun.vbs&quot; -Action set-api -ApiUrl &quot;https://v1.hitokoto.cn/&quot;">
                <local:CustomEventService.Events>
                    <local:CustomEventCollection>
                        <local:CustomEvent Type="弹出提示" Data="正在恢复官方 API……" />
                    </local:CustomEventCollection>
                </local:CustomEventService.Events>
            </local:MyTextButton>
        </WrapPanel>

        <TextBlock TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,2,0,4"
                   Foreground="{DynamicResource ColorBrush2}"
                   Text="{variable:HitokotoApiStatus:当前使用官方 API。}" />

        <TextBlock TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="#999999"
                   Text="自建 HTTPS 实例需要有效证书；如果使用自签名证书，请改用受信任证书或 http 内网地址。API 地址不要包含英文双引号。" />
    </StackPanel>
</local:MyCard>

<local:MyCard Title="句库下载（可选）" Margin="0,0,0,15" CanSwap="True" IsSwapped="True">
    <StackPanel Margin="25,40,23,15">
        <TextBlock TextWrapping="Wrap"
                   FontSize="12.5"
                   Foreground="#666666"
                   Margin="0,0,0,6"
                   Text="把自己的完整句库放到 HTTP 服务器上，填 JSON 地址后下载。支持 JSON 数组，也支持 quotes / data / results / items 包装；字段支持 text 或 hitokoto、source 或 from、author 或 from_who。" />

        <TextBox x:Name="LibraryBox"
                 Text="{variable:HitokotoLibraryUrl:https://example.com/hitokoto.json}"
                 Height="34"
                 Margin="0,2,0,8"
                 Padding="9,0"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 Background="#F7F9FC"
                 BorderBrush="{DynamicResource ColorBrush5}"
                 BorderThickness="1"
                 Foreground="#333333"
                 MaxLength="300"
                 ToolTip="示例地址，请替换成你服务器上的真实 JSON 句库地址" />

        <WrapPanel Margin="0,0,0,4">
            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="18,0,18,0"
                            ColorType="Highlight"
                            Text="下载完整句库"
                            ToolTip="从服务器下载并覆盖本地 library.json"
                            EventType="执行命令"
                            EventData="{Binding Text, ElementName=LibraryBox, StringFormat='wscript.exe|//nologo &quot;HitokotoRun.vbs&quot; -Action download-library -LibraryUrl &quot;{0}&quot;'}">
                <local:CustomEventService.Events>
                    <local:CustomEventCollection>
                        <local:CustomEvent Type="弹出提示" Data="正在从服务器下载句库，请稍候……" />
                    </local:CustomEventCollection>
                </local:CustomEventService.Events>
            </local:MyButton>

            <local:MyTextButton Margin="4,0,10,8"
                                Text="复制句库地址"
                                ToolTip="复制输入框中的句库地址"
                                EventType="复制文本"
                                EventData="{Binding Text, ElementName=LibraryBox}" />
        </WrapPanel>

        <TextBlock TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,2,0,4"
                   Foreground="{DynamicResource ColorBrush2}"
                   Text="{variable:HitokotoLibraryStatus:尚未从服务器下载句库。}" />

        <TextBlock TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="#999999"
                   Text="下载成功后保存为 Hitokoto\library.json，搜索会一并检索；再次下载会覆盖旧句库。示例地址仅作占位，请替换成你自己的服务器地址；地址不要包含英文双引号。" />
    </StackPanel>
</local:MyCard>

