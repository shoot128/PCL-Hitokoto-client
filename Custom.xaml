<!--
    PCL 一言主页 · v1.1
    ==================================================================
    功能：
      - 默认联网从 https://v1.hitokoto.cn/ 获取一言，也支持自建实例；
      - “换一句”刷新，失败时自动降级到离线库；
      - 内置 12 条离线一言，并缓存联网获取的句子；
      - 支持从自己的服务器下载完整 JSON 句库；
      - 在缓存、服务器句库与离线库中搜索（点击结果可复制）；
      - 关于板块提供 GitHub / B 站地址与“打开网页”按钮；
      - 打开时折叠 API/句库/离线库/使用说明，关于卡片固定展开不可折叠；
      - 注明“由 DeepSeek 辅助制作”。

    重要：
      PCL 自定义主页本身不能直接发起 HTTP 请求，也不能读取本地文件。
      因此本主页通过同目录的 HitokotoRun.vbs 隐藏启动 Hitokoto.ps1：
        PowerShell 联网/搜索 → 写入注册表变量 → 向 PCL 发送 F5
      Custom.xaml 再用 variable 替换标记读取这些变量并显示。

      启动器使用相对路径 HitokotoRun.vbs，VBS 再以隐藏窗口调用
      同目录的 Hitokoto.ps1。PCL 执行命令时的工作目录是 PCL 数据
      文件夹（通常是启动器根目录下的 PCL\），所以 Custom.xaml、
      HitokotoRun.vbs、Hitokoto.ps1 和 Hitokoto\ 文件夹要放在一起。
      自定义 API 与句库下载见页面里的“API 设置”“句库下载”卡片。
-->

<StackPanel.Resources>
    <!-- 搜索结果为空时自动隐藏该行；点击结果可复制这句话。 -->
    <Style x:Key="HitokotoResultItem" TargetType="local:MyListItem">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Title, RelativeSource={RelativeSource Self}}" Value="（无）">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</StackPanel.Resources>

<local:MyCard Title="一言 · Hitokoto" Margin="0,0,0,15">
    <StackPanel Margin="25,40,23,15">
        <TextBlock x:Name="QuoteText"
                   TextWrapping="Wrap"
                   FontSize="19"
                   LineHeight="30"
                   Margin="0,0,0,8"
                   Foreground="{DynamicResource ColorBrush1}"
                   Text="{variable:HitokotoText:路漫漫其修远兮，吾将上下而求索。}" />
        <TextBlock TextWrapping="Wrap"
                   FontSize="13"
                   Margin="0,0,0,4"
                   Foreground="#666666"
                   Text="{variable:HitokotoMeta:—— 《离骚》 / 屈原 / 诗词}" />
        <TextBlock TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,0,0,2"
                   Foreground="{DynamicResource ColorBrush2}"
                   Text="{variable:HitokotoStatus:● 离线示例 · 点击“换一句”联网获取}" />
        <TextBlock TextWrapping="Wrap"
                   FontSize="11"
                   Margin="0,0,0,6"
                   Foreground="#888888"
                   Text="{variable:HitokotoInfo:内置离线库与缓存说明见下方。}" />

        <WrapPanel Margin="0,8,0,0">
            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="18,0,18,0"
                            ColorType="Highlight"
                            Text="换一句"
                            ToolTip="联网获取下一条一言；失败时自动使用离线库">
                <local:CustomEventService.Events>
                    <local:CustomEventCollection>
                        <local:CustomEvent Type="弹出提示" Data="正在联网获取一言，请稍候……" />
                        <local:CustomEvent Type="执行命令" Data="wscript.exe|//nologo &quot;HitokotoRun.vbs&quot; -Action next" />
                    </local:CustomEventCollection>
                </local:CustomEventService.Events>
            </local:MyButton>

            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="16,0,16,0"
                            Text="复制这句话"
                            ToolTip="把当前显示的一言复制到剪贴板"
                            EventType="复制文本"
                            EventData="{Binding Text, ElementName=QuoteText}" />

            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="16,0,16,0"
                            Text="刷新显示"
                            ToolTip="如果自动刷新没有生效，点这里重新读取数据"
                            EventType="刷新主页" />

            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="16,0,16,0"
                            Text="打开一言 API"
                            ToolTip="在浏览器中打开 https://v1.hitokoto.cn/"
                            EventType="打开网页"
                            EventData="https://v1.hitokoto.cn/" />
        </WrapPanel>

        <TextBlock TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="#999999"
                   Text="首次点击“换一句”会弹出命令执行确认，请选择“继续且今后不再要求确认”。脚本通过 HitokotoRun.vbs 隐藏运行，不会闪出控制台窗口；若页面没有自动刷新，请点“刷新显示”。" />
        <TextBlock TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="#999999"
                   Margin="0,4,0,0"
                   Text="“API 设置”和“句库下载”在下方可折叠卡片中；关于板块可直接打开 GitHub / B 站。" />
    </StackPanel>
</local:MyCard>

<local:MyCard Title="搜索一言库" Margin="0,0,0,15">
    <StackPanel Margin="25,40,23,15">
        <TextBlock TextWrapping="Wrap"
                   FontSize="12.5"
                   Foreground="#666666"
                   Margin="0,0,0,6"
                   Text="检索已缓存的联网一言、从服务器下载的句库和内置离线库，支持模糊匹配、忽略英文大小写。点击搜索结果可复制该句。" />

        <TextBox x:Name="SearchBox"
                 Height="34"
                 Margin="0,2,0,8"
                 Padding="9,0"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 Background="#F7F9FC"
                 BorderBrush="{DynamicResource ColorBrush5}"
                 BorderThickness="1"
                 Foreground="#333333"
                 MaxLength="40"
                 ToolTip="搜索词请勿包含英文双引号；含引号时请用“复制关键词 → 从剪贴板搜索”。" />

        <WrapPanel Margin="0,0,0,4">
            <!-- 直接使用搜索框中的文本；EventData 的值由 Binding 动态生成。 -->
            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="18,0,18,0"
                            ColorType="Highlight"
                            Text="搜索"
                            ToolTip="在本地离线库和缓存中搜索"
                            EventType="执行命令"
                            EventData="{Binding Text, ElementName=SearchBox, StringFormat='wscript.exe|//nologo &quot;HitokotoRun.vbs&quot; -Action search -Query &quot;{0}&quot;'}">
                <local:CustomEventService.Events>
                    <local:CustomEventCollection>
                        <local:CustomEvent Type="弹出提示" Data="正在搜索本地一言库……" />
                    </local:CustomEventCollection>
                </local:CustomEventService.Events>
            </local:MyButton>

            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="14,0,14,0"
                            Text="复制关键词"
                            ToolTip="把搜索框中的关键词复制到剪贴板"
                            EventType="复制文本"
                            EventData="{Binding Text, ElementName=SearchBox}" />

            <local:MyButton Margin="0,0,10,8"
                            Height="35"
                            Padding="14,0,14,0"
                            Text="从剪贴板搜索"
                            ToolTip="读取剪贴板中的关键词并搜索；适合含英文双引号的关键词"
                            EventType="执行命令"
                            EventData="wscript.exe|//nologo &quot;HitokotoRun.vbs&quot; -Action search-clipboard">
                <local:CustomEventService.Events>
                    <local:CustomEventCollection>
                        <local:CustomEvent Type="弹出提示" Data="正在搜索剪贴板中的关键词……" />
                    </local:CustomEventCollection>
                </local:CustomEventService.Events>
            </local:MyButton>

            <local:MyTextButton Margin="4,0,10,8"
                                Text="清空结果"
                                ToolTip="清空下方搜索结果"
                                EventType="执行命令"
                                EventData="wscript.exe|//nologo &quot;HitokotoRun.vbs&quot; -Action clear">
                <local:CustomEventService.Events>
                    <local:CustomEventCollection>
                        <local:CustomEvent Type="弹出提示" Data="正在清空搜索结果……" />
                    </local:CustomEventCollection>
                </local:CustomEventService.Events>
            </local:MyTextButton>
        </WrapPanel>

        <TextBlock TextWrapping="Wrap"
                   FontSize="12"
                   Margin="0,2,0,6"
                   Foreground="{DynamicResource ColorBrush2}"
                   Text="{variable:HitokotoSearchStatus:输入关键词后点击“搜索”。}" />

        <local:MyListItem Style="{StaticResource HitokotoResultItem}"
                          Margin="-5,2,-5,2"
                          Height="46"
                          Title="{variable:HitokotoResult1Title:（无）}"
                          Info="{variable:HitokotoResult1Info:—}"
                          Type="Clickable"
                          EventType="复制文本"
                          EventData="{Binding Title, RelativeSource={RelativeSource Self}}"
                          ToolTip="点击复制这句话" />
        <local:MyListItem Style="{StaticResource HitokotoResultItem}"
                          Margin="-5,2,-5,2"
                          Height="46"
                          Title="{variable:HitokotoResult2Title:（无）}"
                          Info="{variable:HitokotoResult2Info:—}"
                          Type="Clickable"
                          EventType="复制文本"
                          EventData="{Binding Title, RelativeSource={RelativeSource Self}}"
                          ToolTip="点击复制这句话" />
        <local:MyListItem Style="{StaticResource HitokotoResultItem}"
                          Margin="-5,2,-5,2"
                          Height="46"
                          Title="{variable:HitokotoResult3Title:（无）}"
                          Info="{variable:HitokotoResult3Info:—}"
                          Type="Clickable"
                          EventType="复制文本"
                          EventData="{Binding Title, RelativeSource={RelativeSource Self}}"
                          ToolTip="点击复制这句话" />
        <local:MyListItem Style="{StaticResource HitokotoResultItem}"
                          Margin="-5,2,-5,2"
                          Height="46"
                          Title="{variable:HitokotoResult4Title:（无）}"
                          Info="{variable:HitokotoResult4Info:—}"
                          Type="Clickable"
                          EventType="复制文本"
                          EventData="{Binding Title, RelativeSource={RelativeSource Self}}"
                          ToolTip="点击复制这句话" />
        <local:MyListItem Style="{StaticResource HitokotoResultItem}"
                          Margin="-5,2,-5,2"
                          Height="46"
                          Title="{variable:HitokotoResult5Title:（无）}"
                          Info="{variable:HitokotoResult5Info:—}"
                          Type="Clickable"
                          EventType="复制文本"
                          EventData="{Binding Title, RelativeSource={RelativeSource Self}}"
                          ToolTip="点击复制这句话" />

        <TextBlock TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="#999999"
                   Margin="0,6,0,0"
                   Text="搜索由同目录的 Hitokoto.ps1 完成；如果脚本缺失或被安全软件拦截，搜索结果不会更新，但内置离线库仍可浏览。" />
    </StackPanel>
</local:MyCard>

