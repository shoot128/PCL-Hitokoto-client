{
  "name": "PCL 一言主页内置离线库",
  "updatedAt": "2026-10-24",
  "quotes": [
    {
      "id": "offline-001",
      "text": "路漫漫其修远兮，吾将上下而求索。",
      "source": "《离骚》",
      "author": "屈原",
      "type": "诗词"
    },
    {
      "id": "offline-002",
      "text": "长风破浪会有时，直挂云帆济沧海。",
      "source": "《行路难·其一》",
      "author": "李白",
      "type": "诗词"
    },
    {
      "id": "offline-003",
      "text": "海上生明月，天涯共此时。",
      "source": "《望月怀远》",
      "author": "张九龄",
      "type": "诗词"
    },
    {
      "id": "offline-004",
      "text": "会当凌绝顶，一览众山小。",
      "source": "《望岳》",
      "author": "杜甫",
      "type": "诗词"
    },
    {
      "id": "offline-005",
      "text": "山重水复疑无路，柳暗花明又一村。",
      "source": "《游山西村》",
      "author": "陆游",
      "type": "诗词"
    },
    {
      "id": "offline-006",
      "text": "千磨万击还坚劲，任尔东西南北风。",
      "source": "《竹石》",
      "author": "郑燮",
      "type": "诗词"
    },
    {
      "id": "offline-007",
      "text": "博观而约取，厚积而薄发。",
      "source": "《稼说送张琥》",
      "author": "苏轼",
      "type": "文学"
    },
    {
      "id": "offline-008",
      "text": "纸上得来终觉浅，绝知此事要躬行。",
      "source": "《冬夜读书示子聿》",
      "author": "陆游",
      "type": "诗词"
    },
    {
      "id": "offline-009",
      "text": "天行健，君子以自强不息。",
      "source": "《周易》",
      "author": "",
      "type": "哲学"
    },
    {
      "id": "offline-010",
      "text": "地势坤，君子以厚德载物。",
      "source": "《周易》",
      "author": "",
      "type": "哲学"
    },
    {
      "id": "offline-011",
      "text": "不积跬步，无以至千里；不积小流，无以成江海。",
      "source": "《劝学》",
      "author": "荀子",
      "type": "文学"
    },
    {
      "id": "offline-012",
      "text": "锲而不舍，金石可镂。",
      "source": "《劝学》",
      "author": "荀子",
      "type": "文学"
    }
  ]
}
